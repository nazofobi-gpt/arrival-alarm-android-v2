# Public connector endpoint. Must be HTTPS in production.
NODE_ENV=production
PORT=8787
MCP_PUBLIC_BASE_URL=https://connector.example.com

# OAuth 2.1 authorization server used by ChatGPT/Codex.
OAUTH_AUTHORIZATION_SERVER=https://auth.example.com
OAUTH_ISSUER=https://auth.example.com
OAUTH_AUDIENCE=arrival-alarm
OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Durable gateway state. Mount a persistent volume at /data.
GATEWAY_SQLITE_PATH=/data/arrival-alarm.db

# Optional separate OAuth resource for device tokens.
# Supply all three together or omit all three to reuse OAUTH_* issuer/audience/JWKS.
# DEVICE_OAUTH_ISSUER=https://device-auth.example.com
# DEVICE_OAUTH_AUDIENCE=arrival-device
# DEVICE_OAUTH_JWKS_URL=https://device-auth.example.com/.well-known/jwks.json


# Public native Android OAuth client used to provision the device-bound connector token.
# No client secret belongs in the APK. Register this exact redirect URI at the provider:
# com.nazofobi.arrivalalarm://oauth/callback
DEVICE_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
DEVICE_OAUTH_TOKEN_ENDPOINT=https://auth.example.com/oauth/token
DEVICE_OAUTH_REVOCATION_ENDPOINT=https://auth.example.com/oauth/revoke
DEVICE_OAUTH_CLIENT_ID=arrival-alarm-android
DEVICE_OAUTH_SCOPES=arrival.device offline_access
# Optional RFC 8707 resource indicator. If set, it must be HTTPS.
# DEVICE_OAUTH_RESOURCE=https://connector.example.com/device
# Provider integration must bind this authorization parameter into the access-token device_id claim.
DEVICE_OAUTH_DEVICE_ID_PARAMETER=device_id
